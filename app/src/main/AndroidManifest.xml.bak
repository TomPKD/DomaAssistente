
package com.example.domaassistente

    import android.app.Activity
    import android.content.Intent
    import android.content.pm.PackageManager
    import android.media.AudioDeviceCallback
    import android.media.AudioDeviceInfo
    import android.media.AudioManager
    import android.os.Bundle
    import android.provider.Settings
    import android.speech.tts.TextToSpeech
    import android.view.ViewGroup
    import android.widget.Button
    import android.widget.LinearLayout
    import android.widget.ScrollView
    import android.widget.TextView
    import java.util.Locale

    class MainActivity : Activity(), TextToSpeech.OnInitListener {

    private lateinit var audioManager: AudioManager
    private lateinit var textToSpeech: TextToSpeech
    private lateinit var statusText: TextView

    private var ttsReady = false

    private val audioCallback = object : AudioDeviceCallback() {
    override fun onAudioDevicesAdded(
    addedDevices: Array<out AudioDeviceInfo>
    ) {
    atualizarAudio()
    }

    override fun onAudioDevicesRemoved(
    removedDevices: Array<out AudioDeviceInfo>
    ) {
    atualizarAudio()
    }
    }

    override fun onCreate(savedInstanceState: Bundle?) {
    super.onCreate(savedInstanceState)

    audioManager =
    getSystemService(AUDIO_SERVICE) as AudioManager

    textToSpeech = TextToSpeech(this, this)

    val layout = LinearLayout(this).apply {
    orientation = LinearLayout.VERTICAL
    setPadding(24, 32, 24, 24)
    }

    val titulo = TextView(this).apply {
    text = "Doma Assistente"
    textSize = 24f
    }

    statusText = TextView(this).apply {
    text = "Preparando verificação de áudio..."
    textSize = 16f
    setPadding(0, 20, 0, 20)
    }

    val verificarButton = Button(this).apply {
    text = "Verificar áudio"
    setOnClickListener { atualizarAudio() }
    }

    val mensagemButton = Button(this).apply {
    text = "Ouvir mensagem"
    setOnClickListener {
    falar("Bem-vindo ao Doma Assistente.")
    }
    }

    val alertaButton = Button(this).apply {
    text = "Testar alerta"
    setOnClickListener {
    falar("Atenção. Este é um alerta de segurança.")
    }
    }

    val bluetoothButton = Button(this).apply {
    text = "Configurar Bluetooth"
    setOnClickListener {
    try {
    startActivity(
    Intent(Settings.ACTION_BLUETOOTH_SETTINGS)
    )
    } catch (e: Exception) {
    statusText.text =
    "Não foi possível abrir as configurações Bluetooth."
    }
    }
    }

    layout.addView(titulo)
    layout.addView(statusText)
    layout.addView(verificarButton)
    layout.addView(mensagemButton)
    layout.addView(alertaButton)
    layout.addView(bluetoothButton)

    val scrollView = ScrollView(this)
    scrollView.addView(
    layout,
    ViewGroup.LayoutParams(
    ViewGroup.LayoutParams.MATCH_PARENT,
    ViewGroup.LayoutParams.WRAP_CONTENT
    )
    )

    setContentView(scrollView)

    audioManager.registerAudioDeviceCallback(
    audioCallback,
    null
    )

    atualizarAudio()
    }

    override fun onInit(status: Int) {
    if (status == TextToSpeech.SUCCESS) {
    val resultado = textToSpeech.setLanguage(
    Locale("pt", "BR")
    )

    ttsReady =
    resultado != TextToSpeech.LANG_MISSING_DATA &&
    resultado != TextToSpeech.LANG_NOT_SUPPORTED
    }
    }

    private fun audioOutputAvailable(tipo: Int): Boolean {
    val possuiSaidaAudio = packageManager.hasSystemFeature(
    PackageManager.FEATURE_AUDIO_OUTPUT
    )

    if (!possuiSaidaAudio) return false

    return audioManager.getDevices(
    AudioManager.GET_DEVICES_OUTPUTS
    ).any { it.type == tipo }
    }

    private fun atualizarAudio() {
    val possuiSaidaAudio = packageManager.hasSystemFeature(
    PackageManager.FEATURE_AUDIO_OUTPUT
    )

    val altoFalante = audioOutputAvailable(
    AudioDeviceInfo.TYPE_BUILTIN_SPEAKER
    )

    val bluetooth = audioOutputAvailable(
    AudioDeviceInfo.TYPE_BLUETOOTH_A2DP
    )

    statusText.text = """
    Suporte a saída de áudio: ${if (possuiSaidaAudio) "Sim" else "Não detectado"}
    Alto-falante integrado: ${if (altoFalante) "Detectado" else "Não detectado"}
    Bluetooth A2DP: ${if (bluetooth) "Detectado" else "Não detectado"}
    """.trimIndent()
    }

    private fun falar(mensagem: String) {
    if (ttsReady) {
    textToSpeech.speak(
    mensagem,
    TextToSpeech.QUEUE_FLUSH,
    null,
    "doma_mensagem"
    )
    } else {
    statusText.text =
    "O serviço de voz ainda não está pronto."
    }
    }

    override fun onResume() {
    super.onResume()

    if (::audioManager.isInitialized) {
    atualizarAudio()
    }
    }

    override fun onDestroy() {
    if (::audioManager.isInitialized) {
    audioManager.unregisterAudioDeviceCallback(
    audioCallback
    )
    }

    if (::textToSpeech.isInitialized) {
    textToSpeech.stop()
    textToSpeech.shutdown()
    }

    super.onDestroy()
    }
    }
